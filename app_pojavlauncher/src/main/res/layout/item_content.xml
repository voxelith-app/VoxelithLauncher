<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/background_menu_card"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/content_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/background_icon_round"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/content_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/primary_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/content_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_default"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/content_update"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/button_brand"
        android:contentDescription="@string/content_update"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_content_update"
        android:visibility="gone" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/content_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/content_delete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/button_flat"
        android:contentDescription="@string/content_remove"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_px_trash"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/content_versions"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/button_flat"
        android:contentDescription="@string/content_choose_version"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_content_versions"
        android:visibility="gone" />

    <com.kdt.mcgui.MineButton
        android:id="@+id/content_install"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:minWidth="96dp"
        android:paddingHorizontal="14dp"
        android:background="@drawable/button_brand"
        android:textColor="@color/button_brand_text"
        android:text="@string/content_install"
        android:visibility="gone" />
</LinearLayout>
