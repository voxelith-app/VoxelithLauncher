<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light or not? -->
    <style name="MojoLauncher" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/background_status_bar</item>
        <item name="android:navigationBarColor">@color/background_app</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="dialogCornerRadius">0dp</item>
        <item name="android:seekBarStyle">@style/MojoLauncher.SeekBar</item>
        <item name="seekBarStyle">@style/MojoLauncher.SeekBar</item>
        <item name="android:switchStyle">@style/MojoLauncher.Switch</item>
        <item name="switchStyle">@style/MojoLauncher.Switch</item>
        <item name="buttonStyle">@style/MojoLauncher.Button</item>
        <item name="android:buttonStyleToggle">@style/MojoLauncher.Button.Toggle</item>
        <item name="android:windowBackground">@color/surface_1</item>
        <item name="colorPrimary">@color/surface_2</item>
        <item name="colorPrimaryDark">@color/surface_1</item>
        <item name="colorAccent">@color/voxelith_cyan_light</item>
        <item name="colorControlActivated">@color/voxelith_cyan_light</item>
        <item name="colorControlNormal">@color/text_tertiary</item>
        <item name="colorControlHighlight">#22FFFFFF</item>
        <item name="colorButtonNormal">@color/surface_4</item>
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/text_default</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:colorBackground">@color/surface_1</item>
        <item name="alertDialogTheme">@style/Voxelith.Dialog</item>
        <item name="android:alertDialogTheme">@style/Voxelith.Dialog</item>
        <item name="android:popupBackground">@drawable/menu_background</item>
        <item name="android:dropDownListViewStyle">@style/Voxelith.DropDownList</item>
    </style>

    <style name="Voxelith.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/background_dialog</item>
        <item name="colorAccent">@color/voxelith_cyan_light</item>
        <item name="colorControlActivated">@color/voxelith_cyan_light</item>
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/text_default</item>
        <item name="buttonBarPositiveButtonStyle">@style/Voxelith.Dialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Voxelith.Dialog.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/Voxelith.Dialog.Button</item>
    </style>

    <style name="Voxelith.Transparent" parent="MojoLauncher">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Voxelith.Dialog.Button" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/voxelith_cyan_light</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Voxelith.DropDownList" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:divider">@null</item>
    </style>

    <style name="MojoLauncher.AppTheme" parent="MojoLauncher"/>

    <style name="MojoLauncher.SeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/minepb_progress</item>
        <item name="android:thumb">@drawable/mineknob_on_unfiltered</item>
        <item name="android:thumbOffset">0dp</item>
        <item name="android:maxHeight">4dp</item>
        <item name="android:minHeight">4dp</item>
    </style>

    <style name="MojoLauncher.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="track">@drawable/mineknob_track_mask_unfiltered</item>
        <item name="trackTint">@color/mineknob_track_tint</item>
        <item name="trackTintMode">multiply</item>
        <item name="android:thumb">@drawable/mineknob_switch</item>
        <item name="switchMinWidth">40dp</item>
    </style>

    <style name="MojoLauncher.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_flat</item>
    </style>

    <style name="MojoLauncher.Button.Toggle" parent="MojoLauncher.Button">
        <item name="android:background">@drawable/button_flat_toggle</item>
    </style>


    <style name="LauncherFragment_Divider">
        <item name="android:layout_width">@dimen/padding_tiny</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="LauncherMenuButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/background_menu_card</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="LauncherMenuButton.Universal" parent="LauncherMenuButton">
        <item name="android:layout_height">@dimen/_52sdp</item>
        <item name="android:layout_margin">6dp</item>
    </style>

    <style name="ContentTab" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:background">@drawable/background_tab</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="ContentDetailsHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ContentDetailsBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/text_default</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textIsSelectable">true</item>
    </style>

    <style name="ThickDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_1sdp</item>
        <item name="android:background">?android:attr/listDivider</item>
    </style>

    <item name="dimension_tracker" type="id" />
    <style name="DimensionTracker">
        <item name="android:id">@id/dimension_tracker</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>
</resources>
